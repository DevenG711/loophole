# Loophole settings. `bash setup.sh` makes your own copy of this file, called .env.
# After you change .env, quit Loophole (menu > Quit Loophole) and start it again.

# --- Phone link -----------------------------------------------------------
# Your private channel on ntfy.sh. The iPhone Shortcut sends to
#   https://ntfy.sh/<NTFY_TOPIC>
# setup.sh fills in a random one. Anyone who knows it can read your pickups,
# so keep it long and random and don't share it. If you change it, change the
# URL in every phone automation too.
NTFY_TOPIC=

# --- You ------------------------------------------------------------------
# A short name for this laptop's log file: data/events-<LOOPHOLE_USER>.jsonl
LOOPHOLE_USER=me

# --- Sessions and breaks --------------------------------------------------
# Session lengths offered in "Start focus session", in minutes, comma-separated.
LOOPHOLE_SESSION_LENGTHS=25,50,90
# How long a break lasts, in minutes.
LOOPHOLE_BREAK_MINUTES=5

# --- BehaviorGPT (optional) -----------------------------------------------
# Leave both empty: Loophole uses its shared proxy, so you need no key.
# To use your own key instead: sign in at https://portal.unboxai.com and paste it here.
UNBOXAI_API_KEY=
# Only if you run your own proxy (proxy/README.md).
LOOPHOLE_PROXY_URL=
# The app catalog Loophole ranks against. Don't change this.
LOOPHOLE_CATALOG_ID=cat_35a0afc5ae400da9f74d27e2
